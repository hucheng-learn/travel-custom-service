TRAVEL_API_BASE_URL=http://127.0.0.1:<中台端口>
SUPPORT_DATABASE_URL=mysql+asyncmy://<用户名>:<密码>@127.0.0.1:3306/travel-custom-service?charset=utf8mb4
BUSINESS_TIMEZONE=Asia/Shanghai
TRAVEL_API_TIMEOUT_SECONDS=5
# 中台更换种子时可指定 TRAVEL_AREAS_CSV，默认使用项目自带地区映射。

# 可选，仅本机直接打开客服首页时使用。取消注释并填隔离中台的有效测试用户 ID。
# SUPPORT_PREVIEW_USER_ID=1

# 阶段二可选：不填写时使用本地对话规则，真实密钥只放 .env。
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=8

# 仅在已确认连接的是可写测试中台时开启真实退款提交。
REFUND_WRITE_ENABLED=false
